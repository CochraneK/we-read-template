{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/we-read/knowledge_graph.schema.json",
  "title": "WeRead Knowledge Graph",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "weight"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["book", "theme", "concept", "quote", "review"]},
          "label": {"type": "string", "minLength": 1},
          "summary": {"type": "string"},
          "weight": {"type": "number", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array"},
          "bookId": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "weight"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "type": {"enum": ["contains", "supports", "contrasts", "related"]},
          "weight": {"type": "number", "minimum": 0},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "insights": {"type": "array"},
    "coverage": {"type": "object"}
  },
  "additionalProperties": true
}
