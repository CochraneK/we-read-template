{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CochraneK/we-read/schemas/advisor_context.schema.json",
  "title": "WeRead Advisor Context",
  "type": "object",
  "required": ["version", "privacy", "coverage", "facts", "advisorContract", "guardrails"],
  "properties": {
    "version": {"type": "string"},
    "generatedAt": {"type": "string"},
    "asOf": {"type": "integer", "minimum": 0},
    "privacy": {"type": "object"},
    "coverage": {"type": "object"},
    "facts": {
      "type": "object",
      "required": [
        "depthBands",
        "hiddenDeepBooks",
        "shelvedUnengagedBooks",
        "recent7d",
        "recent30d",
        "recentBooks",
        "categories",
        "deepCategories",
        "shelfHeavyLowEngagementCategories"
      ],
      "properties": {
        "depthBands": {
          "type": "object",
          "required": ["deep20Plus", "medium10To19", "light3To9", "glance1To2", "noNotes"]
        },
        "hiddenDeepBooks": {"type": "array"},
        "shelvedUnengagedBooks": {"type": "array"},
        "recent7d": {"type": "array"},
        "recent30d": {"type": "array"},
        "recentBooks": {"type": "array"},
        "categories": {"type": "array"},
        "deepCategories": {"type": "array"},
        "shelfHeavyLowEngagementCategories": {"type": "array"}
      }
    },
    "advisorContract": {
      "type": "object",
      "required": [
        "readyForRecommendation",
        "nextRequiredStep",
        "gapAxesRequiringEnrichment",
        "mustVerifyAvailability",
        "mustExcludeAlreadyRead",
        "mustExplainEvidence"
      ],
      "properties": {
        "readyForRecommendation": {"const": false},
        "nextRequiredStep": {"type": "string"},
        "gapAxesRequiringEnrichment": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mustVerifyAvailability": {"type": "boolean"},
        "mustExcludeAlreadyRead": {"type": "boolean"},
        "mustExplainEvidence": {"type": "boolean"}
      }
    },
    "guardrails": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    }
  }
}
