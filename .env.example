# Copy to .env and fill only on your own machine.
# .env is gitignored.

WEREAD_API_KEY=

# Keep raw reading data outside the repository when possible.
WEREAD_DATA_DIR=~/.local/share/we-read

# Public Page defaults are privacy-safe.
WEREAD_PAGES_INCLUDE_PRIVATE=0
WEREAD_PAGES_INCLUDE_PUBLIC_QUOTES=0

# Optional history depth.
WEREAD_MONTHLY_HISTORY_MONTHS=48
# WEREAD_START_YEAR=2020

# Optional local semantic Text Mining model/path.
# WEREAD_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional local NLI model/path. Requires explicit entailment/contradiction labels.
# WEREAD_NLI_MODEL=/path/to/local/nli-model
