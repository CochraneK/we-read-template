{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/we-read/reading_profile.schema.json",
  "title": "WeRead Reading Profile",
  "type": "object",
  "required": ["version", "headline", "facts", "interpretations"],
  "properties": {
    "version": {"type": "string"},
    "headline": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": {"type": "string"},
          "value": {"type": ["string", "number"]},
          "detail": {"type": "string"},
          "source": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "summary", "confidence", "evidence"],
        "properties": {
          "label": {"type": "string"},
          "summary": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array"},
          "counterEvidence": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "themes": {"type": "array"},
    "quotes": {"type": "array"},
    "coverage": {"type": "object"}
  },
  "additionalProperties": true
}
