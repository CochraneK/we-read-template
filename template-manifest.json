{
  "schema_version": 1,
  "upstream": "https://github.com/CochraneK/we-read.git",
  "branch": "main",
  "sync_roots": [
    "scripts",
    "schemas",
    "tests"
  ],
  "template_owned": [
    "scripts/build_pages_report.py",
    "scripts/fetch_shelf.py",
    "scripts/pages_command_ui.py",
    "scripts/pages_enrich_site.py",
    "scripts/pages_experience_ui.py",
    "scripts/pages_insights.py",
    "scripts/pages_public_quotes.py",
    "scripts/sync_from_upstream.py",
    "scripts/validate_pages_output.py",
    "scripts/weread.py",
    "tests/test_template_starter.py"
  ],
  "never_sync": [
    "data",
    "site",
    "reports",
    "quote_lib",
    ".workbuddy",
    "README.md",
    "AGENTS.md",
    "SECURITY.md",
    ".github"
  ],
  "sync_exclude": [
    "scripts/analysis.py"
  ]
}
